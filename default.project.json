{
  "name": "DriftwakeIsles",
  "globIgnorePaths": ["**/*.md"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/shared" },
      "Remotes": { "$className": "Folder" },
      "WorldState": {
        "$className": "Folder",
        "Weather": { "$className": "StringValue", "$properties": { "Value": "Clear" } },
        "Event": { "$className": "StringValue", "$properties": { "Value": "" } }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": { "$path": "src/server" }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/client" }
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": { "CharacterAutoLoads": false }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.36, 0.40, 0.50],
        "OutdoorAmbient": [0.45, 0.50, 0.62],
        "Brightness": 2.6,
        "ClockTime": 9,
        "GeographicLatitude": 28,
        "GlobalShadows": true,
        "ShadowSoftness": 0,
        "EnvironmentDiffuseScale": 0.45,
        "EnvironmentSpecularScale": 0.25,
        "ExposureCompensation": 0.1
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.2,
          "Color": [0.78, 0.86, 0.95],
          "Decay": [0.55, 0.62, 0.78],
          "Glare": 0.25,
          "Haze": 1.4
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.3, "Size": 24, "Threshold": 1.15 }
      },
      "ColorGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": { "Saturation": 0.18, "Contrast": 0.08, "TintColor": [1, 0.98, 0.95] }
      },
      "Sky": {
        "$className": "Sky",
        "$properties": { "StarCount": 3500, "SunAngularSize": 12, "MoonAngularSize": 10 }
      }
    }
  }
}
